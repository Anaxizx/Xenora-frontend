# MongoDB connection string (get free one from MongoDB Atlas: https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/xenora

# JWT secret - use a long random string in production (generate: openssl rand -base64 48)
JWT_SECRET=change_this_to_a_long_random_secret_string

# JWT token expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (for CORS) - set to your deployed frontend domain in production
CLIENT_URL=http://localhost:5500

# Node environment
NODE_ENV=development
